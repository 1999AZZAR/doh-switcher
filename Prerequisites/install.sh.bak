#!/usr/bin/env bash

# This script installs and configures DNS over HTTPS (DoH) using cloudflared
# Can be used for both fresh installation and reinstallation
# Usage: sudo ./install.sh

# ANSI color codes
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m'

# Global variables
SCRIPT_LOG="/tmp/doh_install.log"
ERRORS_ENCOUNTERED=0
WARNINGS_ENCOUNTERED=0
BACKUP_DIR="/tmp/doh_backup_$(date +%Y%m%d_%H%M%S)"
UPSTREAM="https://cloudflare-dns.com/dns-query"
INSTALL_MODE="install"
CLOUDFLARED_VERSION=""
SYSTEM_ARCH=""
PACKAGE_MANAGER=""

# Logging functions
log() { echo "$(date '+%Y-%m-%d %H:%M:%S') - $*" >> "$SCRIPT_LOG"; }
step() { echo -e "${BLUE}[STEP]${NC} $*"; log "STEP: $*"; }
info() { echo -e "${GREEN}[OK]${NC} $*"; log "OK: $*"; }
warn() { echo -e "${YELLOW}[WARN]${NC} $*"; log "WARN: $*"; ((WARNINGS_ENCOUNTERED++)); }
error() { echo -e "${RED}[ERROR]${NC} $*"; log "ERROR: $*"; ((ERRORS_ENCOUNTERED++)); }
debug() { echo -e "${CYAN}[DEBUG]${NC} $*"; log "DEBUG: $*"; }

# Execute command with error handling
safe_exec() {
    local cmd="$1"
    local description="$2"
    local critical="${3:-false}"

    log "Executing: $cmd"

    if eval "$cmd" >> "$SCRIPT_LOG" 2>&1; then
        info "$description - Success"
        return 0
    else
        local exit_code=$?
        if [ "$critical" = "true" ]; then
            error "$description - Failed (exit code: $exit_code) - This is critical"
            return $exit_code
        else
            warn "$description - Failed (exit code: $exit_code) - Continuing anyway"
            return 0
        fi
    fi
}

# Check if command exists
command_exists() {
    command -v "$1" >/dev/null 2>&1
}

# Check if service exists
service_exists() {
    systemctl list-unit-files --type=service 2>/dev/null | grep -q "^$1.service" 2>/dev/null
}

# Check if user exists
user_exists() {
    id "$1" &>/dev/null
}

# Create backup of important files
create_backup() {
    local file="$1"
    local description="${2:-$file}"

    if [ -f "$file" ] || [ -L "$file" ]; then
        mkdir -p "$BACKUP_DIR"
        if cp -L "$file" "$BACKUP_DIR/" 2>/dev/null; then
            info "Backed up $description to $BACKUP_DIR"
        else
            warn "Failed to backup $description"
        fi
    fi
}

# Detect system architecture
detect_architecture() {
    local arch=$(uname -m)
    case "$arch" in
        x86_64|amd64)
            SYSTEM_ARCH="amd64"
            ;;
        aarch64|arm64)
            SYSTEM_ARCH="arm64"
            ;;
        armv7l|armhf)
            SYSTEM_ARCH="arm"
            ;;
        i386|i686)
            SYSTEM_ARCH="386"
            ;;
        *)
            error "Unsupported architecture: $arch"
            return 1
            ;;
    esac
    info "Detected architecture: $SYSTEM_ARCH"
}

# Detect package manager
detect_package_manager() {
    if command_exists "apt-get"; then
        PACKAGE_MANAGER="apt"
    elif command_exists "yum"; then
        PACKAGE_MANAGER="yum"
    elif command_exists "dnf"; then
        PACKAGE_MANAGER="dnf"
    elif command_exists "pacman"; then
        PACKAGE_MANAGER="pacman"
    else
        warn "No supported package manager found, will try manual installation"
        PACKAGE_MANAGER="manual"
    fi
    info "Package manager: $PACKAGE_MANAGER"
}

# Check if cloudflared is already installed
check_existing_installation() {
    local cloudflared_binary=""
    local installed_version=""

    # Check for binary in common locations
    for path in "/usr/bin/cloudflared" "/usr/local/bin/cloudflared" "/opt/cloudflared/bin/cloudflared"; do
        if [ -f "$path" ] && [ -x "$path" ]; then
            cloudflared_binary="$path"
            break
        fi
    done

    if [ -n "$cloudflared_binary" ]; then
        installed_version=$($cloudflared_binary --version 2>/dev/null | head -1 || echo "unknown")
        warn "Cloudflared is already installed at: $cloudflared_binary"
        warn "Installed version: $installed_version"

        # Check if service is running
        if service_exists "cloudflared"; then
            if systemctl is-active --quiet cloudflared; then
                warn "Cloudflared service is currently running"
            else
                warn "Cloudflared service exists but is not running"
            fi
        fi

        # Check for existing configuration
        if [ -f "/etc/systemd/system/cloudflared.service" ]; then
            warn "Existing service configuration found"
        fi

        INSTALL_MODE="reinstall"
        return 0
    else
        info "No existing cloudflared installation detected"
        INSTALL_MODE="install"
        return 1
    fi
}

# Pre-installation checks
run_prechecks() {
    step "Running pre-installation checks..."

    # Check if running as root
    if [ "$(id -u)" -ne 0 ]; then
        error "Please run this script as root or with sudo"
        exit 1
    fi

    # Check internet connectivity
    if ! ping -c1 -W5 8.8.8.8 >/dev/null 2>&1; then
        error "No internet connectivity detected"
        exit 1
    fi
    info "Internet connectivity: OK"

    # Check available disk space (need at least 50MB)
    local available_space=$(df /tmp | awk 'NR==2 {print $4}')
    if [ "$available_space" -lt 51200 ]; then
        warn "Low disk space in /tmp (less than 50MB available)"
    fi

    # Check if port 53 is already in use
    if command_exists "lsof"; then
        local port53_process=$(lsof -ti:53 2>/dev/null)
        if [ -n "$port53_process" ] && ! pgrep -f cloudflared >/dev/null; then
            warn "Port 53 is already in use by process(es): $port53_process"
            warn "Conflicting services will be stopped after successful download"

            # Identify the services using port 53 for user information
            local conflicting_services=""
            if lsof -ti:53 | xargs -I {} ps -p {} -o comm= 2>/dev/null | grep -q systemd-resolved; then
                conflicting_services="$conflicting_services systemd-resolved"
            fi
            if lsof -ti:53 | xargs -I {} ps -p {} -o comm= 2>/dev/null | grep -q dnsmasq; then
                conflicting_services="$conflicting_services dnsmasq"
            fi
            if lsof -ti:53 | xargs -I {} ps -p {} -o comm= 2>/dev/null | grep -q named; then
                conflicting_services="$conflicting_services bind9"
            fi
            if lsof -ti:53 | xargs -I {} ps -p {} -o comm= 2>/dev/null | grep -q unbound; then
                conflicting_services="$conflicting_services unbound"
            fi

            if [ -n "$conflicting_services" ]; then
                info "Will stop these DNS services:$conflicting_services"
            fi
        fi
    fi

    # Check systemd availability
    if ! command_exists "systemctl"; then
        error "systemd is required but not found"
        exit 1
    fi
    info "systemd: Available"

    # Detect system details
    detect_architecture || exit 1
    detect_package_manager

    info "Pre-checks completed successfully"
}

# Stop existing cloudflared if running (for reinstall mode)
stop_existing_cloudflared_service() {
    if service_exists "cloudflared" && systemctl is-active --quiet cloudflared; then
        step "Stopping existing cloudflared service..."
        safe_exec "systemctl stop cloudflared" "Stop existing service"
        sleep 2

        # Force kill if still running
        if pgrep -f cloudflared >/dev/null; then
            safe_exec "pkill -f cloudflared" "Force kill existing processes"
            sleep 1
        fi
    fi
}

# Stop conflicting DNS services
stop_conflicting_services() {
    step "Stopping conflicting DNS services..."

    local services_stopped=0

    # Check if port 53 is in use
    if ! command_exists "lsof"; then
        warn "lsof not available, cannot detect port conflicts"
        return 0
    fi

    local port53_processes=$(lsof -ti:53 2>/dev/null)
    if [ -z "$port53_processes" ]; then
        info "No services using port 53, proceeding"
        return 0
    fi

    # Stop systemd-resolved first (most common conflict)
    if systemctl is-active --quiet systemd-resolved 2>/dev/null; then
        info "Stopping systemd-resolved..."
        safe_exec "systemctl stop systemd-resolved" "Stop systemd-resolved"
        safe_exec "systemctl disable systemd-resolved" "Disable systemd-resolved"
        safe_exec "systemctl mask systemd-resolved" "Mask systemd-resolved to prevent auto-restart"
        ((services_stopped++))
    fi

    # Stop other common DNS services
    local dns_services="dnsmasq bind9 named unbound pihole-FTL AdGuardHome systemd-networkd NetworkManager-wait-online"

    for service in $dns_services; do
        if systemctl is-active --quiet "$service" 2>/dev/null; then
            info "Stopping $service..."
            safe_exec "systemctl stop $service" "Stop $service"
            safe_exec "systemctl disable $service" "Disable $service"
            ((services_stopped++))
        fi
    done

    # Wait longer for services to fully stop
    sleep 5

    # Check for NetworkManager's internal DNS stub
    if pgrep NetworkManager >/dev/null && [ -f "/etc/NetworkManager/NetworkManager.conf" ]; then
        info "Disabling NetworkManager's internal DNS stub..."
        # Create backup
        create_backup "/etc/NetworkManager/NetworkManager.conf" "NetworkManager config"

        # Disable DNS stub in NetworkManager
        if ! grep -q "dns=none" /etc/NetworkManager/NetworkManager.conf; then
            safe_exec "sed -i '/\[main\]/a dns=none' /etc/NetworkManager/NetworkManager.conf" "Disable NetworkManager DNS"
            safe_exec "systemctl reload NetworkManager" "Reload NetworkManager"
            sleep 2
        fi
    fi

    # Force kill any remaining processes on port 53 (both TCP and UDP)
    for proto in tcp udp; do
        local remaining_processes=$(lsof -ti:53 -P$proto 2>/dev/null)
        if [ -n "$remaining_processes" ]; then
            warn "Force killing remaining $proto processes on port 53"
            for pid in $remaining_processes; do
                local process_name=$(ps -p "$pid" -o comm= 2>/dev/null || echo "unknown")
                if [ "$process_name" != "cloudflared" ]; then
                    info "Force killing $process_name (PID: $pid) using port 53/$proto"
                    safe_exec "kill -9 $pid" "Kill process $pid"
                fi
            done
        fi
    done

    # Additional wait after force killing
    sleep 3

    # Check if anything is still binding to the UDP socket specifically
    local udp_conflicts=$(ss -tulpn | grep ':53 ' | grep -v cloudflared || true)
    if [ -n "$udp_conflicts" ]; then
        warn "Still found processes listening on port 53:"
        echo "$udp_conflicts" | while read line; do
            warn "  $line"
        done

        # Try to extract PIDs and kill them
        echo "$udp_conflicts" | grep -o 'pid=[0-9]*' | sed 's/pid=//' | while read pid; do
            if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
                local proc_name=$(ps -p "$pid" -o comm= 2>/dev/null || echo "unknown")
                info "Force killing remaining process: $proc_name (PID: $pid)"
                safe_exec "kill -9 $pid" "Kill stubborn process $pid"
            fi
        done

        sleep 2
    fi

    # Final verification with multiple tools
    local final_lsof=$(lsof -ti:53 2>/dev/null)
    local final_ss=$(ss -tulpn | grep ':53 ' | grep -v cloudflared || true)

    if [ -z "$final_lsof" ] && [ -z "$final_ss" ]; then
        info "Port 53 is now completely free for cloudflared"
    else
        warn "Some processes may still be using port 53:"
        if [ -n "$final_lsof" ]; then
            lsof -i :53 2>/dev/null >> "$SCRIPT_LOG" || true
        fi
        if [ -n "$final_ss" ]; then
            echo "$final_ss" >> "$SCRIPT_LOG"
        fi
    fi

    if [ $services_stopped -gt 0 ]; then
        info "Stopped $services_stopped conflicting DNS services"
    else
        info "No conflicting DNS services found running"
    fi

    # Disable any DNS stub resolvers that might restart
    if [ -f "/etc/systemd/resolved.conf" ]; then
        create_backup "/etc/systemd/resolved.conf" "systemd resolved config"
        safe_exec "sed -i 's/#DNSStubListener=yes/DNSStubListener=no/' /etc/systemd/resolved.conf" "Disable DNS stub listener"
        safe_exec "sed -i 's/DNSStubListener=yes/DNSStubListener=no/' /etc/systemd/resolved.conf" "Disable DNS stub listener"
    fi
}

# Update package index
update_package_index() {
    step "Updating package index..."
    case "$PACKAGE_MANAGER" in
        apt)
            safe_exec "apt-get update -y" "Update apt package index" "true"
            ;;
        yum)
            safe_exec "yum check-update" "Update yum package index"
            ;;
        dnf)
            safe_exec "dnf check-update" "Update dnf package index"
            ;;
        pacman)
            safe_exec "pacman -Sy" "Update pacman package index"
            ;;
        *)
            info "Manual installation mode, skipping package index update"
            ;;
    esac
}

# Download cloudflared
download_cloudflared() {
    step "Downloading cloudflared..."

    # Skip download if we're in reinstall mode and binary exists
    if [ "$INSTALL_MODE" = "reinstall" ]; then
        local existing_binary=""
        for path in "/usr/bin/cloudflared" "/usr/local/bin/cloudflared"; do
            if [ -f "$path" ] && [ -x "$path" ]; then
                existing_binary="$path"
                break
            fi
        done

        if [ -n "$existing_binary" ]; then
            info "Reinstall mode: Using existing cloudflared binary at $existing_binary"
            info "Skipping download step"
            return 0
        else
            warn "Reinstall mode but binary not found, proceeding with download"
        fi
    fi

    local download_url=""
    local temp_file="/tmp/cloudflared"

    # Determine download URL based on package manager and architecture
    case "$PACKAGE_MANAGER" in
        apt)
            temp_file="/tmp/cloudflared.deb"
            download_url="https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-${SYSTEM_ARCH}.deb"
            ;;
        yum|dnf)
            temp_file="/tmp/cloudflared.rpm"
            download_url="https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-${SYSTEM_ARCH}.rpm"
            ;;
        *)
            temp_file="/tmp/cloudflared"
            download_url="https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-${SYSTEM_ARCH}"
            ;;
    esac

    # Try wget first, then curl
    if command_exists "wget"; then
        safe_exec "wget -q --timeout=30 -O '$temp_file' '$download_url'" "Download with wget" "true"
    elif command_exists "curl"; then
        safe_exec "curl -L --max-time 30 -o '$temp_file' '$download_url'" "Download with curl" "true"
    else
        error "Neither wget nor curl found, cannot download cloudflared"
        exit 1
    fi

    # Verify download
    if [ ! -f "$temp_file" ] || [ ! -s "$temp_file" ]; then
        error "Downloaded file is empty or missing"
        exit 1
    fi

    info "Downloaded cloudflared successfully"
}

# Install cloudflared
install_cloudflared() {
    step "Installing cloudflared..."

    # Skip installation if we're in reinstall mode and just using existing binary
    if [ "$INSTALL_MODE" = "reinstall" ]; then
        local existing_binary=""
        for path in "/usr/bin/cloudflared" "/usr/local/bin/cloudflared"; do
            if [ -f "$path" ] && [ -x "$path" ]; then
                existing_binary="$path"
                break
            fi
        done

        if [ -n "$existing_binary" ]; then
            CLOUDFLARED_VERSION=$($existing_binary --version 2>/dev/null | head -1 || echo "unknown")
            info "Using existing cloudflared installation: $CLOUDFLARED_VERSION"
            return 0
        fi
    fi

    # Proceed with fresh installation
    case "$PACKAGE_MANAGER" in
        apt)
            if ! safe_exec "dpkg -i /tmp/cloudflared.deb" "Install deb package"; then
                safe_exec "apt-get install -f -y" "Fix dependencies" "true"
            fi
            ;;
        yum)
            safe_exec "yum install -y /tmp/cloudflared.rpm" "Install rpm package (yum)" "true"
            ;;
        dnf)
            safe_exec "dnf install -y /tmp/cloudflared.rpm" "Install rpm package (dnf)" "true"
            ;;
        *)
            # Manual installation
            safe_exec "chmod +x /tmp/cloudflared" "Make binary executable" "true"
            safe_exec "mv /tmp/cloudflared /usr/local/bin/cloudflared" "Move binary to /usr/local/bin" "true"
            ;;
    esac

    # Verify installation
    local cloudflared_path=""
    for path in "/usr/bin/cloudflared" "/usr/local/bin/cloudflared"; do
        if [ -f "$path" ] && [ -x "$path" ]; then
            cloudflared_path="$path"
            break
        fi
    done

    if [ -z "$cloudflared_path" ]; then
        error "Cloudflared installation failed - binary not found"
        exit 1
    fi

    CLOUDFLARED_VERSION=$($cloudflared_path --version 2>/dev/null | head -1 || echo "unknown")
    info "Cloudflared installed successfully: $CLOUDFLARED_VERSION"
}

# Create service user
create_service_user() {
    step "Creating service user..."

    if user_exists "cloudflared"; then
        info "Service user already exists, skipping creation"
    else
        safe_exec "useradd -r -s /usr/sbin/nologin cloudflared" "Create cloudflared user" "true"
    fi

    # Create group if it doesn't exist
    if ! getent group cloudflared >/dev/null 2>&1; then
        safe_exec "groupadd -r cloudflared" "Create cloudflared group"
    fi
}

# Create systemd service
create_systemd_service() {
    step "Creating systemd service..."

    # Backup existing service file if it exists
    create_backup "/etc/systemd/system/cloudflared.service" "existing service file"

    # Find cloudflared binary path
    local binary_path=""
    for path in "/usr/bin/cloudflared" "/usr/local/bin/cloudflared"; do
        if [ -f "$path" ] && [ -x "$path" ]; then
            binary_path="$path"
            break
        fi
    done

    if [ -z "$binary_path" ]; then
        error "Cannot find cloudflared binary"
        exit 1
    fi

    # Check if we have capabilities set
    local has_capabilities=false
    if getcap "$binary_path" 2>/dev/null | grep -q "cap_net_bind_service"; then
        has_capabilities=true
        info "Cloudflared has port binding capabilities, service will run as cloudflared user"
    else
        warn "No port binding capabilities detected, service will run as root"
    fi

    # Create service file based on capabilities
    if [ "$has_capabilities" = "true" ]; then
        # Service with user privileges (preferred)
        cat > /etc/systemd/system/cloudflared.service <<EOF
[Unit]
Description=cloudflared DNS over HTTPS proxy
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
ExecStart=$binary_path proxy-dns --port 53 --upstream $UPSTREAM
User=cloudflared
Group=cloudflared
Restart=always
RestartSec=2
TimeoutStopSec=20
LimitNOFILE=4096
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
EOF
    else
        # Service with root privileges (fallback)
        cat > /etc/systemd/system/cloudflared.service <<EOF
[Unit]
Description=cloudflared DNS over HTTPS proxy
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
ExecStart=$binary_path proxy-dns --port 53 --upstream $UPSTREAM
User=root
Group=root
Restart=always
RestartSec=2
TimeoutStopSec=20
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
EOF
        warn "Service configured to run as root due to capability issues"
    fi

    info "Systemd service created successfully"
}

# Grant port binding permissions
grant_port_permissions() {
    step "Granting permissions to bind port 53..."

    local binary_path=""
    local capabilities_set=0

    # Find all cloudflared binaries and set capabilities
    for path in "/usr/bin/cloudflared" "/usr/local/bin/cloudflared"; do
        if [ -f "$path" ] && [ -x "$path" ]; then
            binary_path="$path"
            info "Found cloudflared binary at: $path"

            # Try to set capabilities
            if setcap 'cap_net_bind_service=+ep' "$path" 2>/dev/null; then
                info "Successfully granted port binding capability to $path"
                ((capabilities_set++))
            else
                warn "Failed to set capabilities on $path, trying alternative approach"

                # Alternative: ensure the service runs as root temporarily
                info "Will modify service to run with elevated privileges"
            fi

            # Verify capabilities were set
            local current_caps=$(getcap "$path" 2>/dev/null || echo "none")
            info "Current capabilities for $path: $current_caps"
        fi
    done

    if [ $capabilities_set -eq 0 ]; then
        warn "No capabilities set successfully - service will need root privileges"
        # We'll handle this in the systemd service configuration
        return 1
    fi

    return 0
}

# Configure DNS resolution
configure_dns() {
    step "Configuring DNS resolution..."

    # Backup current resolv.conf
    create_backup "/etc/resolv.conf" "current resolv.conf"

    # Stop and disable systemd-resolved if it's running
    if systemctl is-active --quiet systemd-resolved 2>/dev/null; then
        safe_exec "systemctl stop systemd-resolved" "Stop systemd-resolved"
    fi

    if systemctl is-enabled --quiet systemd-resolved 2>/dev/null; then
        safe_exec "systemctl disable systemd-resolved" "Disable systemd-resolved"
    fi

    # Remove immutable flag from resolv.conf if it exists
    if [ -f "/etc/resolv.conf" ]; then
        safe_exec "chattr -i /etc/resolv.conf" "Remove immutable flag from resolv.conf"
    fi

    # Update resolv.conf
    safe_exec "rm -f /etc/resolv.conf" "Remove current resolv.conf"

    # Create new resolv.conf
    cat > /etc/resolv.conf <<'EOF'
# Generated by cloudflared DoH setup
# Use local cloudflared proxy for DNS resolution
nameserver 127.0.0.1

# Fallback nameservers (in case cloudflared fails)
# nameserver 8.8.8.8
# nameserver 1.1.1.1
EOF

    if [ $? -eq 0 ]; then
        info "Created new resolv.conf successfully"
    else
        error "Failed to create resolv.conf"
        return 1
    fi

    # Make resolv.conf immutable to prevent overwrites
    safe_exec "chattr +i /etc/resolv.conf" "Make resolv.conf immutable"

    info "DNS configuration updated"
}

# Configure firewall rules
configure_firewall() {
    step "Configuring firewall rules..."

    # iptables
    if command_exists "iptables"; then
        if ! iptables -C INPUT -p tcp --dport 53 -j ACCEPT 2>/dev/null; then
            safe_exec "iptables -I INPUT -p tcp --dport 53 -j ACCEPT" "Add iptables TCP rule"
        fi
        if ! iptables -C INPUT -p udp --dport 53 -j ACCEPT 2>/dev/null; then
            safe_exec "iptables -I INPUT -p udp --dport 53 -j ACCEPT" "Add iptables UDP rule"
        fi
    fi

    # ufw
    if command_exists "ufw"; then
        safe_exec "ufw allow 53" "Allow port 53 in ufw"
    fi

    # firewalld
    if command_exists "firewall-cmd"; then
        safe_exec "firewall-cmd --permanent --add-port=53/tcp" "Add firewalld TCP rule"
        safe_exec "firewall-cmd --permanent --add-port=53/udp" "Add firewalld UDP rule"
        safe_exec "firewall-cmd --reload" "Reload firewalld"
    fi

    info "Firewall rules configured"
}

# Setup network restart hooks
setup_network_hooks() {
    step "Setting up network restart hooks..."

    # Install networkd-dispatcher if available
    case "$PACKAGE_MANAGER" in
        apt)
            if ! dpkg -l | grep -q networkd-dispatcher; then
                safe_exec "apt-get install -y networkd-dispatcher" "Install networkd-dispatcher"
            fi
            ;;
        yum|dnf)
            # networkd-dispatcher might not be available, skip with warning
            warn "networkd-dispatcher not available for this distribution"
            return 0
            ;;
    esac

    # Create hook directory and script
    safe_exec "mkdir -p /etc/networkd-dispatcher/routable.d" "Create hook directory"

    cat > /etc/networkd-dispatcher/routable.d/restart-cloudflared.sh <<'EOF'
#!/bin/bash
# Auto-restart cloudflared when network becomes routable
if systemctl is-active --quiet cloudflared; then
    logger "Network became routable, restarting cloudflared"
    systemctl restart cloudflared
fi
EOF

    safe_exec "chmod +x /etc/networkd-dispatcher/routable.d/restart-cloudflared.sh" "Make hook executable"

    # Restart networkd-dispatcher if it exists
    if systemctl list-unit-files | grep -q networkd-dispatcher; then
        safe_exec "systemctl restart networkd-dispatcher" "Restart networkd-dispatcher"
    fi

    info "Network hooks configured"
}

# Start and enable service
start_service() {
    step "Starting and enabling cloudflared service..."

    safe_exec "systemctl daemon-reload" "Reload systemd daemon" "true"
    safe_exec "systemctl enable cloudflared" "Enable cloudflared service" "true"

    # Before starting, do one final check for port conflicts
    local final_port_check=$(lsof -ti:53 2>/dev/null)
    if [ -n "$final_port_check" ]; then
        warn "Last-minute port conflict detected, attempting final cleanup..."
        for pid in $final_port_check; do
            local process_name=$(ps -p "$pid" -o comm= 2>/dev/null || echo "unknown")
            if [ "$process_name" != "cloudflared" ]; then
                info "Killing final conflict: $process_name (PID: $pid)"
                safe_exec "kill -9 $pid" "Kill final conflict $pid"
            fi
        done
        sleep 2
    fi

    safe_exec "systemctl start cloudflared" "Start cloudflared service" "true"

    # Wait longer for service to start and stabilize
    sleep 5

    # Verify service is running and check for errors
    if systemctl is-active --quiet cloudflared; then
        info "Cloudflared service is running successfully"

        # Check if it's actually listening on port 53
        local listening_check=$(lsof -ti:53 2>/dev/null | head -1)
        if [ -n "$listening_check" ]; then
            local listening_process=$(ps -p "$listening_check" -o comm= 2>/dev/null || echo "unknown")
            if [ "$listening_process" = "cloudflared" ]; then
                info "Cloudflared is successfully listening on port 53"
            else
                warn "Port 53 is occupied by $listening_process instead of cloudflared"
            fi
        else
            warn "No process detected listening on port 53"
        fi
    else
        warn "Cloudflared service may not be running properly"
        # Get detailed status and logs
        systemctl status cloudflared --no-pager >> "$SCRIPT_LOG" 2>&1
        journalctl -u cloudflared -n 20 --no-pager >> "$SCRIPT_LOG" 2>&1

        # Show some debug info
        warn "Service status and recent logs have been saved to $SCRIPT_LOG"
        warn "Recent error from logs:"
        journalctl -u cloudflared -n 3 --no-pager | grep -E "(ERR|ERROR)" | tail -1

        # Check common issues
        info "Checking common issues..."

        # Check if port is available
        local port_status=$(lsof -ti:53 2>/dev/null)
        if [ -n "$port_status" ]; then
            warn "Port 53 is still occupied by PID: $port_status"
            ps -p $port_status -o pid,comm,args 2>/dev/null >> "$SCRIPT_LOG" || true
        fi

        # Check if binary has correct permissions
        local binary_path=""
        for path in "/usr/bin/cloudflared" "/usr/local/bin/cloudflared"; do
            if [ -f "$path" ] && [ -x "$path" ]; then
                binary_path="$path"
                break
            fi
        done

        if [ -n "$binary_path" ]; then
            local perms=$(ls -la "$binary_path")
            local caps=$(getcap "$binary_path" 2>/dev/null || echo "none")
            info "Binary permissions: $perms"
            info "Binary capabilities: $caps"
        fi

        # Try to start manually for debugging
        info "Attempting manual start for debugging..."
        timeout 10 "$binary_path" proxy-dns --port 53 --upstream "$UPSTREAM" >> "$SCRIPT_LOG" 2>&1 &
        local manual_pid=$!
        sleep 3

        if kill -0 $manual_pid 2>/dev/null; then
            info "Manual start succeeded, killing test process"
            kill $manual_pid 2>/dev/null

            # Try service restart again
            info "Attempting final service restart..."
            safe_exec "systemctl restart cloudflared" "Final restart attempt"
            sleep 5

            if systemctl is-active --quiet cloudflared; then
                info "Final service restart successful!"
            else
                warn "Service still failing - may need manual intervention"
            fi
        else
            warn "Manual start also failed - check permissions and port availability"
        fi
    fi
}

# Run post-installation tests
run_tests() {
    step "Running post-installation tests..."

    # Test 1: Check if cloudflared is listening on port 53
    if command_exists "lsof"; then
        if lsof -ti:53 | grep -q .; then
            info "Port 53 test: PASS - Service is listening"
        else
            warn "Port 53 test: FAIL - No service listening on port 53"
        fi
    fi

    # Test 2: Test local DNS resolution
    if nslookup google.com 127.0.0.1 >/dev/null 2>&1; then
        info "Local DNS test: PASS - Can resolve via localhost"
    else
        warn "Local DNS test: FAIL - Cannot resolve via localhost"
    fi

    # Test 3: Test DoH functionality (if dig is available)
    if command_exists "dig"; then
        if dig @127.0.0.1 +short google.com >/dev/null 2>&1; then
            info "DoH functionality test: PASS"
        else
            warn "DoH functionality test: FAIL"
        fi
    fi

    # Test 5: Verify no other services are using port 53
    local port53_conflicts=$(lsof -ti:53 2>/dev/null | grep -v $(pgrep cloudflared) 2>/dev/null || true)
    if [ -z "$port53_conflicts" ]; then
        info "Port 53 exclusivity test: PASS - Only cloudflared using port 53"
    else
        warn "Port 53 exclusivity test: FAIL - Other services still using port 53"
    fi
    if ping -c1 -W5 google.com >/dev/null 2>&1; then
        info "Internet connectivity test: PASS"
    else
        warn "Internet connectivity test: FAIL - Check your network"
    fi
}

# Main installation flow
main() {
    # Initialize log
    echo "=== DoH Install/Reinstall Log Started at $(date) ===" > "$SCRIPT_LOG"
    mkdir -p "$BACKUP_DIR"

    # Header
    info "=== DNS-over-HTTPS (DoH) Robust Installer/Reinstaller ==="
    info "Log file: $SCRIPT_LOG"
    info "Backup directory: $BACKUP_DIR"
    echo

    # Run pre-checks
    run_prechecks

    # Check for existing installation
    check_existing_installation

    # Show installation mode
    if [ "$INSTALL_MODE" = "reinstall" ]; then
        warn "REINSTALL MODE: Existing installation detected"
        echo
        read -p $'\033[1;33mProceed with reinstallation? [y/N]: \033[0m' confirm
    else
        info "INSTALL MODE: Fresh installation"
        echo
        read -p $'\033[1;33mProceed with installation? [y/N]: \033[0m' confirm
    fi

    if [[ ! "$confirm" =~ ^[Yy] ]]; then
        error "Aborted by user."
        exit 1
    fi

    # Ask for custom DoH upstream
    echo
    read -p $'\033[1;33mUse default DoH upstream (Cloudflare)? [Y/n]: \033[0m' use_default
    if [[ "$use_default" =~ ^[Nn] ]]; then
        echo "Available DoH providers:"
        echo "1. Cloudflare: https://cloudflare-dns.com/dns-query"
        echo "2. Quad9: https://dns.quad9.net/dns-query"
        echo "3. Google: https://dns.google/dns-query"
        echo "4. Custom URL"
        echo
        read -p $'\033[1;33mEnter DoH URL or press Enter for default: \033[0m' custom_url
        if [ -n "$custom_url" ]; then
            UPSTREAM="$custom_url"
        fi
    fi
    info "Using DoH upstream: $UPSTREAM"
    echo

    # Stop existing cloudflared service if reinstalling
    if [ "$INSTALL_MODE" = "reinstall" ]; then
        stop_existing_cloudflared_service
    fi

    # Installation steps
    step "Starting installation process..."

    update_package_index
    download_cloudflared

    # Stop conflicting DNS services after successful download
    stop_conflicting_services

    install_cloudflared
    create_service_user
    create_systemd_service
    grant_port_permissions
    configure_dns
    configure_firewall
    setup_network_hooks
    start_service

    # Run tests
    run_tests

    # Summary
    echo
    info "=== Installation Summary ==="
    info "Mode: $INSTALL_MODE"
    info "Version: $CLOUDFLARED_VERSION"
    info "Architecture: $SYSTEM_ARCH"
    info "DoH Upstream: $UPSTREAM"
    info "Errors: $ERRORS_ENCOUNTERED"
    info "Warnings: $WARNINGS_ENCOUNTERED"
    info "Backup directory: $BACKUP_DIR"
    info "Log file: $SCRIPT_LOG"

    if [ $ERRORS_ENCOUNTERED -eq 0 ]; then
        info "✅ Installation completed successfully!"
        info "DNS-over-HTTPS is now active on your system."
    else
        warn "⚠️  Installation completed with $ERRORS_ENCOUNTERED errors."
        warn "Please check the log file for details: $SCRIPT_LOG"
    fi

    echo
    info "Verification commands:"
    info "• Check service status: systemctl status cloudflared"
    info "• Test DNS resolution: nslookup google.com"
    info "• Check listening ports: sudo lsof -i :53"
    info "• View service logs: journalctl -u cloudflared -f"

    if [ $WARNINGS_ENCOUNTERED -gt 0 ] || [ $ERRORS_ENCOUNTERED -gt 0 ]; then
        echo
        warn "If you encounter issues:"
        warn "• Check the log file: $SCRIPT_LOG"
        warn "• Restore from backup: $BACKUP_DIR"
        warn "• Run the uninstall script to revert changes"
    fi
}

# Trap to ensure cleanup on exit
trap 'echo "Script interrupted. Check log: $SCRIPT_LOG"' INT TERM

# Run main function
main "$@"

exit 0
